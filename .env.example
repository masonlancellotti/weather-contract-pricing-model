# Weather Contract Pricing Model — configuration template
# Copy to .env and fill in. Safe defaults: nothing trades until you flip them.

# ── Safety (defaults are OFF; see config.py) ─────────────────────────────
LIVE_ENABLED=false          # true → real-money orders. Leave false.
KILL_SWITCH=false           # true → halts all order placement immediately
KALSHI_DEMO=true            # use Kalshi's demo environment

# ── Kalshi (RSA-PSS API auth) ────────────────────────────────────────────
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# ── Polymarket CLOB (EIP-712 + HMAC) ─────────────────────────────────────
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_CHAIN_ID=137

# ── Risk caps ────────────────────────────────────────────────────────────
MAX_CONTRACTS_PER_ORDER=10
MAX_ORDER_SIZE_USD=25
MAX_VENUE_EXPOSURE_USD=100
MIN_EDGE_THRESHOLD=0.05

# ── Data / cadence ───────────────────────────────────────────────────────
ACTIVE_CITIES=nyc,chi,mia
WEATHER_REFRESH_SECONDS=300
MARKET_POLL_SECONDS=60
ORDER_STALE_SECONDS=120
NOAA_CDO_TOKEN=
LOG_LEVEL=INFO
DB_PATH=weather_trader.db
